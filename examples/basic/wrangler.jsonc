{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rss8",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rss8",
      // From `npx wrangler d1 create rss8`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // The engine's migrations. In your own repo, with rss8 as a submodule at
      // vendor/rss8, this is "vendor/rss8/packages/engine/migrations".
      "migrations_dir": "../../packages/engine/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER", "class_name": "Runner" },
      { "name": "API", "class_name": "Api" }
    ]
  },
  // Declared once, before the first deploy. A class change (add, rename,
  // delete) ships in its own deploy: deleting a class deletes its data, and
  // `wrangler rollback` never crosses a class change.
  "exports": {
    "Runner": { "type": "durable-object", "storage": "sqlite" },
    "Api": { "type": "durable-object", "storage": "sqlite" }
  },
  // From `npx wrangler queues create rss8`. One message per invocation; the
  // engine relies on max_retries being 3.
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "rss8" }],
    "consumers": [{ "queue": "rss8", "max_batch_size": 1, "max_retries": 3 }]
  },
  // Exactly one trigger, restricting only the minute field. The engine decides
  // which feeds are due on each tick.
  "triggers": { "crons": ["0,15,30,45 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Lets /health report the running version.
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
